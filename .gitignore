# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/

# uv / virtualenv
.venv/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# Project-specific (per CLAUDE.md):
#   data/   — large 17Lands CSVs and processed parquet files; never committed,
#             except for the parsed_cards/ carve-out below.
#   models/ — trained XGBoost artifacts; shared via GitHub Releases later.
#
# Carve-out: data/processed/parsed_cards/ IS committed. The JSONs are
# small (~2 MB total across TMT/ECL/TLA) and contain hand-encoded
# role_features for the LLM_ENCODED entries that can't be
# deterministically regenerated. Tracking them prevents accidental
# data loss (a botched re-run silently destroys the hand-encoded
# fields) and makes parser-widening PRs show the actual
# reclassification diff in code review.
#
# Pattern: ignore everything under data/, then re-include the carve-out.
# Note that re-inclusion requires the parent directories to be
# reachable, hence the /data/processed/ negation in the middle.
/data/*
!/data/processed/
/data/processed/*
!/data/processed/parsed_cards/
models/

# DuckDB transient/lock files (the .duckdb file itself lives under data/)
*.duckdb-wal
*.duckdb.wal
*.duckdb.tmp

# Per-user Claude Code harness state (permissions allowlist, lock files
# for scheduled tasks, etc.). Only the local variants are ignored;
# project-shared `.claude/settings.json` (if it ever exists) IS committed.
.claude/settings.local.json
.claude/*.lock

# Regenerable parse-demo dumps. Re-run `uv run mulligan-coach-cards
# --set <SET>` to produce a fresh one for review.
packages/cards/*-parse-demo.json

# Equivalence-harness baselines for the simulator (see
# packages/simulation/scripts/equivalence_harness.py). The JSON blobs
# bind to a specific games.duckdb sample and the simulator's current
# output shape; they're meant to be regenerated locally before any
# perf-tuning PR, not version-controlled.
packages/simulation/baseline*.json

# Ad-hoc debugging screenshots dropped by the user/Claude during overlay
# iteration. Useful in the moment, not worth versioning.
packages/overlay/screenshots/
